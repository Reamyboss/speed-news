# ---------------------------------------------------------------------------
# NaijaPulse environment. Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Local development (zero infrastructure):
DATABASE_URL="file:./dev.db"
# Production example (Neon / Supabase / RDS):
# DATABASE_URL="postgresql://user:password@host:5432/naijapulse?sslmode=require"
#
# Optional. Inferred from DATABASE_URL when omitted. One of: sqlite | postgresql
# DATABASE_PROVIDER="postgresql"

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="NaijaPulse"

# --- AI provider -----------------------------------------------------------
# One of: anthropic | none.  Defaults to `anthropic` when a key is present,
# otherwise the deterministic extractive fallback is used and the site still
# renders normally. AI is never required for the product to work.
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"
# Model id. Default is the most capable model. For high-volume enrichment you
# may prefer "claude-sonnet-5" or "claude-haiku-4-5" — that is a cost decision.
# Max stories enriched per pipeline run (cost control).
AI_ENRICH_BATCH_SIZE="25"

# --- Ingest ----------------------------------------------------------------
# Max items pulled per source per run.
INGEST_MAX_ITEMS_PER_SOURCE="25"
INGEST_CONCURRENCY="8"
INGEST_TIMEOUT_MS="15000"
# Shared secret for /api/cron/pipeline. REQUIRED IN PRODUCTION: without it the
# endpoint refuses every request, so nothing is ever ingested. Must be at least
# 16 characters — /api/health reports a shorter one as a blocker.
#
# The bearer token is the ONLY accepted credential. Vercel adds
# `Authorization: Bearer $CRON_SECRET` to its cron invocations automatically
# once this is set in the project, so no extra wiring is needed.
#
#   openssl rand -hex 32
CRON_SECRET=""

# --- Analytics (analytics-ready, provider-agnostic) ------------------------
# One of: none | plausible | ga4 | umami
NEXT_PUBLIC_ANALYTICS_PROVIDER="none"
NEXT_PUBLIC_ANALYTICS_DOMAIN=""
NEXT_PUBLIC_ANALYTICS_ID=""
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=""

# --- Ads -------------------------------------------------------------------
# Ad inventory is database-driven (see the AdSlot model). These are only
# global toggles / provider account ids.
NEXT_PUBLIC_ADS_ENABLED="true"
NEXT_PUBLIC_ADSENSE_CLIENT=""
NEXT_PUBLIC_GAM_NETWORK_CODE=""
# --- AI providers -----------------------------------------------------------
# Supported: anthropic | gemini | groq | none
AI_PROVIDER="gemini"

# Optional second provider for future fallback routing.
AI_FALLBACK_PROVIDER="groq"

# Anthropic
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"

# Google Gemini
GEMINI_API_KEY=""
AI_GEMINI_MODEL="gemini-3.6-flash"

# Groq
GROQ_API_KEY=""
AI_GROQ_MODEL="openai/gpt-oss-20b"

AI_ENRICH_BATCH_SIZE="25"
